<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily Chair Raffle</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Canvas Confetti Library CDN -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts for vibrant kid-friendly typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Fredoka', 'Outfit', sans-serif;
            touch-action: manipulation; /* Prevents double-tap zoom on Smart Boards */
            user-select: none; /* Prevents text selection while tapping */
        }
        
        .number-btn {
            transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .number-btn:active {
            transform: scale(0.92);
        }

        .number-btn.selected {
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            box-shadow: 0 8px 20px -4px rgba(16, 185, 129, 0.5), inset 0 2px 4px rgba(255, 255, 255, 0.3);
            color: white;
            border-color: #34D399;
        }

        /* Pulse animation for winner cards */
        @keyframes popIn {
            0% { transform: scale(0.5); opacity: 0; }
            70% { transform: scale(1.1); }
            100% { transform: scale(1); opacity: 1; }
        }

        .pop-in {
            animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        /* Slot machine tick visual */
        .ticker-number {
            animation: tickJump 0.08s infinite ease-in-out alternate;
        }

        @keyframes tickJump {
            from { transform: translateY(-4px); }
            to { transform: translateY(4px); }
        }
    </style>
</head>
<body class="bg-slate-900 text-white min-h-screen flex flex-col justify-between p-3 sm:p-6 overflow-x-hidden">

    <!-- TOP HEADER / DASHBOARD -->
    <header class="max-w-6xl w-full mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 bg-slate-800/80 p-4 rounded-3xl border border-slate-700/60 shadow-xl backdrop-blur-md">
        <div class="flex items-center gap-3 text-center sm:text-left">
            <div class="w-12 h-12 sm:w-14 sm:h-14 bg-gradient-to-tr from-amber-400 to-amber-500 rounded-2xl flex items-center justify-center text-2xl sm:text-3xl shadow-lg shadow-amber-500/20">
                🪑
            </div>
            <div>
                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-400 to-orange-400">
                    Special Chair Drawing
                </h1>
                <p class="text-slate-400 text-sm font-semibold">Tap your student number to enter today's raffle!</p>
            </div>
        </div>

        <!-- Counter & Quick Actions -->
        <div class="flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-end">
            <!-- Counter Badge -->
            <div class="bg-slate-900/90 border border-slate-700 px-4 py-2 rounded-2xl flex items-center gap-2">
                <span class="text-xs uppercase tracking-wider text-slate-400 font-bold">Entered:</span>
                <span id="counter" class="text-2xl font-black text-amber-400">0</span>
                <span class="text-slate-500 font-bold">/ 32</span>
            </div>

            <!-- Utility Buttons -->
            <div class="flex gap-2">
                <button onclick="selectAll()" title="Select All" class="px-3 py-2 bg-slate-700 hover:bg-slate-600 active:bg-slate-800 text-xs font-bold rounded-xl transition border border-slate-600 text-slate-200">
                    Select All
                </button>
                <button onclick="clearAll()" title="Reset Entries" class="px-3 py-2 bg-slate-700 hover:bg-slate-600 active:bg-slate-800 text-xs font-bold rounded-xl transition border border-slate-600 text-rose-300">
                    Clear All
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN GRID CONTAINER -->
    <main class="max-w-6xl w-full mx-auto my-4 flex-1 flex flex-col justify-center">
        <!-- 32 Grid Items layout (8x4 on desktop, 4x8 on mobile/tablet) -->
        <div id="grid" class="grid grid-cols-4 sm:grid-cols-8 gap-2.5 sm:gap-4 w-full">
            <!-- Buttons dynamically generated via Javascript -->
        </div>
    </main>

    <!-- BOTTOM DRAW BUTTON FOOTER -->
    <footer class="max-w-6xl w-full mx-auto bg-slate-800/80 p-4 rounded-3xl border border-slate-700/60 shadow-xl backdrop-blur-md flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="flex items-center gap-2 text-slate-400 text-xs sm:text-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Tap number again to uncheck • Draw randomly selects 5</span>
        </div>

        <button id="drawBtn" onclick="startDrawing()" class="w-full sm:w-auto px-8 py-3.5 bg-gradient-to-r from-amber-400 via-amber-500 to-orange-500 hover:from-amber-300 hover:to-orange-400 text-slate-950 font-black text-xl rounded-2xl shadow-lg shadow-amber-500/25 active:scale-95 transition-all flex items-center justify-center gap-2">
            <span>✨</span>
            <span>DRAW 5 WINNERS!</span>
        </button>
    </footer>

    <!-- WINNERS MODAL OVERLAY -->
    <div id="winnerModal" class="fixed inset-0 bg-slate-950/90 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-900 border border-slate-700 rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl relative text-center flex flex-col items-center">
            
            <div class="w-16 h-16 bg-gradient-to-br from-amber-400 to-orange-500 rounded-2xl flex items-center justify-center text-3xl shadow-xl shadow-amber-500/30 mb-3 animate-bounce">
                👑
            </div>

            <h2 class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-amber-300 to-orange-400 mb-1">
                Today's Special Chair Winners!
            </h2>
            <p id="drawingSubtitle" class="text-slate-400 text-sm font-semibold mb-6">Congratulations to our lucky 5 daily winners!</p>

            <!-- Ticker / Animating Stage -->
            <div id="tickerBox" class="hidden my-8 py-8 px-12 bg-slate-800/80 rounded-2xl border border-slate-700/80">
                <div id="tickerNumber" class="text-7xl sm:text-8xl font-black text-amber-400 tracking-wider font-mono">--</div>
                <div class="text-slate-400 font-bold mt-2 text-sm uppercase tracking-widest">Shuffling Numbers...</div>
            </div>

            <!-- Winners List Grid -->
            <div id="winnersGrid" class="grid grid-cols-2 sm:grid-cols-5 gap-3 w-full my-4">
                <!-- Dynamically populated with winner cards -->
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap sm:flex-nowrap gap-3 w-full mt-6">
                <button onclick="rerollAll()" class="w-full sm:w-1/2 py-3 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold rounded-xl transition border border-slate-700 text-sm flex items-center justify-center gap-2">
                    🔄 Redraw All 5
                </button>
                <button onclick="closeModal()" class="w-full sm:w-1/2 py-3 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black rounded-xl transition shadow-lg shadow-emerald-500/20 text-base">
                    Done & Close
                </button>
            </div>
        </div>
    </div>

    <script>
        const TOTAL_STUDENTS = 32;
        let selectedNumbers = new Set();
        let currentWinners = [];

        // Web Audio API Sound Synthesizer
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playTapSound(isSelecting) {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sine';
            
            const now = audioCtx.currentTime;
            if (isSelecting) {
                osc.frequency.setValueAtTime(440, now);
                osc.frequency.exponentialRampToValueAtTime(880, now + 0.08);
            } else {
                osc.frequency.setValueAtTime(350, now);
                osc.frequency.exponentialRampToValueAtTime(220, now + 0.08);
            }

            gain.gain.setValueAtTime(0.15, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);

            osc.connect(gain);
            gain.connect(audioCtx.destination);

            osc.start(now);
            osc.stop(now + 0.08);
        }

        function playFanfareSound() {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            
            const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
            notes.forEach((freq, idx) => {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'triangle';
                osc.frequency.value = freq;
                
                const startTime = audioCtx.currentTime + (idx * 0.1);
                gain.gain.setValueAtTime(0.2, startTime);
                gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.4);

                osc.connect(gain);
                gain.connect(audioCtx.destination);

                osc.start(startTime);
                osc.stop(startTime + 0.4);
            });
        }

        function initGrid() {
            const gridEl = document.getElementById('grid');
            gridEl.innerHTML = '';

            // Load saved state from LocalStorage if available
            const saved = localStorage.getItem('chair_raffle_entered');
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    selectedNumbers = new Set(parsed);
                } catch(e) {
                    selectedNumbers = new Set();
                }
            }

            for (let i = 1; i <= TOTAL_STUDENTS; i++) {
                const btn = document.createElement('button');
                btn.id = `btn-${i}`;
                btn.className = `number-btn relative flex flex-col items-center justify-center p-3 sm:p-5 rounded-2xl font-black text-2xl sm:text-3xl border-2 transition-all cursor-pointer select-none min-h-[70px] sm:min-h-[85px] ${
                    selectedNumbers.has(i) 
                    ? 'selected' 
                    : 'bg-slate-800/90 border-slate-700/80 text-slate-300 hover:border-slate-500 hover:bg-slate-750'
                }`;

                btn.onclick = () => toggleNumber(i);

                btn.innerHTML = `
                    <span>${i}</span>
                    <span id="check-${i}" class="absolute top-1.5 right-2 text-xs font-bold text-emerald-300 ${selectedNumbers.has(i) ? 'block' : 'hidden'}">✓</span>
                `;

                gridEl.appendChild(btn);
            }

            updateCounter();
        }

        function toggleNumber(num) {
            const btn = document.getElementById(`btn-${num}`);
            const check = document.getElementById(`check-${num}`);

            if (selectedNumbers.has(num)) {
                selectedNumbers.delete(num);
                btn.classList.remove('selected');
                btn.classList.add('bg-slate-800/90', 'border-slate-700/80', 'text-slate-300');
                check.classList.add('hidden');
                check.classList.remove('block');
                playTapSound(false);
            } else {
                selectedNumbers.add(num);
                btn.classList.add('selected');
                btn.classList.remove('bg-slate-800/90', 'border-slate-700/80', 'text-slate-300');
                check.classList.remove('hidden');
                check.classList.add('block');
                playTapSound(true);
            }

            saveState();
            updateCounter();
        }

        function updateCounter() {
            document.getElementById('counter').innerText = selectedNumbers.size;
        }

        function saveState() {
            localStorage.setItem('chair_raffle_entered', JSON.stringify([...selectedNumbers]));
        }

        function selectAll() {
            for (let i = 1; i <= TOTAL_STUDENTS; i++) {
                selectedNumbers.add(i);
            }
            saveState();
            initGrid();
            playTapSound(true);
        }

        function clearAll() {
            selectedNumbers.clear();
            saveState();
            initGrid();
            playTapSound(false);
        }

        function startDrawing() {
            const pool = Array.from(selectedNumbers);

            if (pool.length === 0) {
                showToast("Please tap at least one number to start the drawing!");
                return;
            }

            const modal = document.getElementById('winnerModal');
            const tickerBox = document.getElementById('tickerBox');
            const winnersGrid = document.getElementById('winnersGrid');
            const tickerNum = document.getElementById('tickerNumber');

            modal.classList.remove('hidden');
            winnersGrid.innerHTML = '';
            tickerBox.classList.remove('hidden');

            // Pick up to 5 unique winners
            const winnerCount = Math.min(5, pool.length);
            const shuffled = [...pool].sort(() => Math.random() - 0.5);
            currentWinners = shuffled.slice(0, winnerCount);

            // Animate ticker (Slot Machine Shuffle Effect)
            let duration = 1200; // 1.2 seconds of ticker
            let intervalTime = 50;
            let elapsed = 0;

            const timer = setInterval(() => {
                const randomTemp = pool[Math.floor(Math.random() * pool.length)];
                tickerNum.innerText = randomTemp < 10 ? `0${randomTemp}` : randomTemp;
                elapsed += intervalTime;

                if (elapsed >= duration) {
                    clearInterval(timer);
                    tickerBox.classList.add('hidden');
                    displayWinners();
                }
            }, intervalTime);
        }

        function displayWinners() {
            const winnersGrid = document.getElementById('winnersGrid');
            winnersGrid.innerHTML = '';

            currentWinners.forEach((num, index) => {
                const card = document.createElement('div');
                card.className = "pop-in bg-gradient-to-b from-amber-500/20 to-orange-500/10 border-2 border-amber-400/60 rounded-2xl p-4 flex flex-col items-center justify-between shadow-lg relative group";
                card.style.animationDelay = `${index * 0.12}s`;

                card.innerHTML = `
                    <span class="text-xs font-bold uppercase text-amber-300/80 tracking-wider">Seat #${index + 1}</span>
                    <span class="text-4xl sm:text-5xl font-black text-amber-300 my-2">${num}</span>
                    <button onclick="rerollSingle(${index})" title="Redraw this spot" class="mt-1 px-2 py-1 bg-slate-800/80 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-bold border border-slate-600/80 flex items-center gap-1 transition">
                        <span>🔄</span>
                        <span>Redraw</span>
                    </button>
                `;

                winnersGrid.appendChild(card);
            });

            // Trigger celebration visuals & fanfare audio
            playFanfareSound();
            triggerConfetti();
        }

        function rerollSingle(index) {
            const pool = Array.from(selectedNumbers);
            const available = pool.filter(n => !currentWinners.includes(n));

            if (available.length === 0) {
                showToast("No other available numbers left in today's entry pool!");
                return;
            }

            const newWinner = available[Math.floor(Math.random() * available.length)];
            currentWinners[index] = newWinner;
            displayWinners();
        }

        function rerollAll() {
            startDrawing();
        }

        function closeModal() {
            document.getElementById('winnerModal').classList.add('hidden');
        }

        function triggerConfetti() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 80,
                    spread: 70,
                    origin: { y: 0.6 },
                    colors: ['#FBBF24', '#F59E0B', '#10B981', '#3B82F6', '#EC4899']
                });
            }
        }

        function showToast(message) {
            const toast = document.createElement('div');
            toast.className = "fixed bottom-6 left-1/2 -translate-x-1/2 bg-amber-500 text-slate-950 px-6 py-3 rounded-2xl font-black text-sm shadow-2xl z-50 transition-all transform animate-bounce";
            toast.innerText = message;
            document.body.appendChild(toast);

            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        window.onload = function() {
            initGrid();
        };
    </script>
</body>
</html>
